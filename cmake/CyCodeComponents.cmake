# Native source integration. No graphical dependency or Engine initialization.
function(cycode_add_components)
  get_filename_component(_cycode_source "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." REALPATH)
  set(_cycode_known Files Snippets Protocol Documents TextSession TextBridge Process Transport)
  foreach(_cycode_component IN LISTS ARGN)
    if(NOT _cycode_component IN_LIST _cycode_known)
      message(FATAL_ERROR "Unknown native CyCode component: ${_cycode_component}")
    endif()
  endforeach()
  if(TARGET CyCode::Files)
    get_target_property(_cycode_common cycode_files SOURCE_DIR)
    get_filename_component(_cycode_common "${_cycode_common}" REALPATH)
    if(NOT _cycode_common STREQUAL "${_cycode_source}/common")
      message(FATAL_ERROR "Do not mix different CyCode source checkouts in one target graph")
    endif()
  else()
    if(NOT DEFINED CYCODE_COMMON_DEPS)
      if(DEFINED CYCODE_DEPS)
        set(CYCODE_COMMON_DEPS "${CYCODE_DEPS}")
      else()
        set(CYCODE_COMMON_DEPS "${_cycode_source}/runtime/deps")
      endif()
    endif()
    add_subdirectory("${_cycode_source}/common" "${CMAKE_CURRENT_BINARY_DIR}/cycode-common")
  endif()
  if((Documents IN_LIST ARGN OR TextSession IN_LIST ARGN OR TextBridge IN_LIST ARGN) AND NOT TARGET CyCode::Documents)
    add_subdirectory("${_cycode_source}/modules/Documents" "${CMAKE_CURRENT_BINARY_DIR}/cycode-documents")
  endif()
  if(Process IN_LIST ARGN AND NOT TARGET CyCode::Process)
    add_subdirectory("${_cycode_source}/modules/Process" "${CMAKE_CURRENT_BINARY_DIR}/cycode-process")
  endif()
  if((Transport IN_LIST ARGN OR TextBridge IN_LIST ARGN) AND NOT TARGET CyCode::Transport)
    add_subdirectory("${_cycode_source}/modules/Transport" "${CMAKE_CURRENT_BINARY_DIR}/cycode-transport")
  endif()
  if(TextBridge IN_LIST ARGN AND NOT TARGET CyCode::TextBridge)
    add_subdirectory("${_cycode_source}/modules/Documents/bridge" "${CMAKE_CURRENT_BINARY_DIR}/cycode-text-bridge")
  endif()
endfunction()
