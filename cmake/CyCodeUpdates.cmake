# One immutable consumer identity per native update library / target graph.
# Set these normal/cache variables before adding the Core subdirectory.
function(cycode_configure_updates output_directory)
  if(NOT DEFINED CYCODE_UPDATES_PRODUCT)
    set(CYCODE_UPDATES_PRODUCT CyCode)
  endif()
  string(LENGTH "${CYCODE_UPDATES_PRODUCT}" _length)
  string(TOLOWER "${CYCODE_UPDATES_PRODUCT}" _folded)
  if(NOT CYCODE_UPDATES_PRODUCT MATCHES "^[A-Za-z][A-Za-z0-9_]*$" OR _length GREATER 64 OR
     _folded MATCHES "^(con|prn|aux|nul|com[1-9]|lpt[1-9])$")
    message(FATAL_ERROR "Invalid CYCODE_UPDATES_PRODUCT: use a safe ASCII product identifier")
  endif()
  if(NOT DEFINED CYCODE_UPDATES_REPOSITORY)
    if(NOT CYCODE_UPDATES_PRODUCT STREQUAL "CyCode")
      message(FATAL_ERROR "A consumer update product requires explicit CYCODE_UPDATES_REPOSITORY")
    endif()
    set(CYCODE_UPDATES_REPOSITORY MrMybal/CyCode)
  endif()
  string(LENGTH "${CYCODE_UPDATES_REPOSITORY}" _length)
  if(NOT CYCODE_UPDATES_REPOSITORY MATCHES "^[A-Za-z0-9_][A-Za-z0-9_.-]*/[A-Za-z0-9_][A-Za-z0-9_.-]*$" OR
     _length GREATER 200 OR CYCODE_UPDATES_REPOSITORY MATCHES "(^|/)\\.\\.?(/|$)")
    message(FATAL_ERROR "Invalid CYCODE_UPDATES_REPOSITORY: use owner/repository, never a URL or token")
  endif()
  if(NOT DEFINED CYCODE_UPDATES_VERSION)
    if(NOT CYCODE_UPDATES_PRODUCT STREQUAL "CyCode")
      message(FATAL_ERROR "A consumer update product requires its own CYCODE_UPDATES_VERSION")
    endif()
    set(CYCODE_UPDATES_VERSION "${PROJECT_VERSION}")
  endif()
  if(NOT CYCODE_UPDATES_VERSION MATCHES "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$")
    message(FATAL_ERROR "Invalid CYCODE_UPDATES_VERSION: expected MAJOR.MINOR.PATCH")
  endif()
  foreach(_part "${CMAKE_MATCH_1}" "${CMAKE_MATCH_2}" "${CMAKE_MATCH_3}")
    string(LENGTH "${_part}" _length)
    if(_length GREATER 5 OR _part GREATER 65535)
      message(FATAL_ERROR "CYCODE_UPDATES_VERSION components must not exceed 65535")
    endif()
  endforeach()
  set(CYCODE_UPDATES_LEGACY false)
  set(CYCODE_UPDATES_MARKER "${CYCODE_UPDATES_PRODUCT}-installed.flag")
  if(CYCODE_UPDATES_PRODUCT STREQUAL "CyCode" AND CYCODE_UPDATES_REPOSITORY STREQUAL "MrMybal/CyCode")
    set(CYCODE_UPDATES_LEGACY true)
    set(CYCODE_UPDATES_MARKER installed.flag)
  endif()
  string(TOUPPER "${CYCODE_UPDATES_PRODUCT}" CYCODE_UPDATES_TOKEN_PREFIX)
  foreach(_field PRODUCT REPOSITORY VERSION)
    get_property(_configured TARGET cycode_updates PROPERTY CYCODE_UPDATES_${_field} SET)
    if(_configured)
      get_target_property(_actual cycode_updates CYCODE_UPDATES_${_field})
      if(NOT _actual STREQUAL "${CYCODE_UPDATES_${_field}}")
        message(FATAL_ERROR "Do not reconfigure an existing CyCode::Updates target for another product/repository/version")
      endif()
    endif()
  endforeach()
  get_filename_component(_source "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." REALPATH)
  configure_file("${_source}/app/resources/UpdateProductConfig.h.in"
                 "${output_directory}/cycode/UpdateProductConfig.h" @ONLY)
  # The property also lets hosts assert their identity before linking a helper.
  set_property(TARGET cycode_updates PROPERTY CYCODE_UPDATES_PRODUCT "${CYCODE_UPDATES_PRODUCT}")
  set_property(TARGET cycode_updates PROPERTY CYCODE_UPDATES_REPOSITORY "${CYCODE_UPDATES_REPOSITORY}")
  set_property(TARGET cycode_updates PROPERTY CYCODE_UPDATES_VERSION "${CYCODE_UPDATES_VERSION}")
endfunction()
